<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>epidemiologia</id>
    <name>Epidemiología</name>
    <summary>Alertas del MINSAL, del ISP y de la OPS/OMS, informe semanal de circulación de virus respiratorios del ISP y tablero nacional</summary>
    <description><![CDATA[
Muestra dentro de la intranet la información epidemiológica que publican el MINSAL, el
ISP y la OPS/OMS. Del MINSAL: las alertas epidemiológicas vigentes y las del Departamento
de Epidemiología, el tablero nacional de vigilancia ETI e IRAG y el acceso a EPIVIGILA.
Del ISP: el informe semanal de circulación de virus respiratorios, por semana
epidemiológica, y sus alertas de medicamentos (ANAMED), farmacovigilancia y vigilancia de
cosméticos. De la OPS/OMS: sus alertas y actualizaciones epidemiológicas.

Lee y enlaza información pública. De ella guarda solo lo necesario para servirla, nunca
datos de pacientes: en la base de datos de la instancia, los metadatos que publican el
MINSAL, el ISP y la OPS/OMS; en el almacenamiento propio de la app, el documento de cada
informe semanal de circulación de virus respiratorios, descargado una sola vez. Las alertas siguen siendo enlaces a los
documentos en el sitio oficial de quien las publica.
    ]]></description>
    <version>0.11.3</version>
    <licence>AGPL-3.0-or-later</licence>
    <author mail="d.espinoza.charrier@gmail.com">Daniel Espinoza</author>
    <namespace>Epidemiologia</namespace>
    <documentation>
        <admin>https://aps-conecta.github.io/documentation/desarrollo/epidemiologia.html#configuracion</admin>
        <developer>https://aps-conecta.github.io/documentation/desarrollo/epidemiologia.html</developer>
    </documentation>
    <category>monitoring</category>
    <dependencies>
        <!-- Nextcloud only *recommends* intl, but AlertRepository::fold() needs
             Normalizer, and fold() runs on every unified search by every user.
             Declared so a host without intl refuses to enable the app, instead of
             taking down global search with a fatal. -->
        <lib>intl</lib>
        <php min-version="8.2" max-version="8.5"/>
        <nextcloud min-version="34" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\Epidemiologia\BackgroundJob\ProbeJob</job>
        <job>OCA\Epidemiologia\BackgroundJob\RefreshJob</job>
        <job>OCA\Epidemiologia\BackgroundJob\WarmJob</job>
    </background-jobs>
    <navigations>
        <navigation>
            <name>Epidemiología</name>
            <route>epidemiologia.page.index</route>
            <!-- Without <icon> the menu falls back to places/default-app-icon.svg,
                 the generic placeholder. img/app-dark.svg exists separately and is
                 used only by the notification: the navigation never asks for the
                 dark variant. -->
            <icon>epidemiologia.svg</icon>
            <!-- Deliberate: ahead of the apps with no <order>, which land at 100.
                 Vigencia is the whole point of Alertas vigentes — an alert nobody
                 sees while it is in force is the failure this app exists to prevent. -->
            <order>5</order>
        </navigation>
    </navigations>
    <!--
      The residue wipe lives here, not in the migration's postSchemaChange,
      because that hook is skipped when an app's schema is applied on a first
      install — and the keys and rows it wipes exist only on installs that
      predate this release, which arrive via post-migration anyway. Registered
      for both events; the step is idempotent, so a second run finds nothing
      and does nothing (territorio's EnsureSeedData pattern).
    -->
    <repair-steps>
        <install>
            <step>OCA\Epidemiologia\Migration\RetireSanitaryAlerts</step>
        </install>
        <post-migration>
            <step>OCA\Epidemiologia\Migration\RetireSanitaryAlerts</step>
        </post-migration>
    </repair-steps>
</info>
