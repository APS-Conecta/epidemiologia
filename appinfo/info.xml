<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>epidemiologia</id>
    <name>Epidemiología</name>
    <summary>Alertas del MINSAL y del ISP, informes IRAG y tablero nacional</summary>
    <description><![CDATA[
Muestra dentro de la intranet la información epidemiológica que el MINSAL publica:
las alertas epidemiológicas vigentes, el informe semanal de vigilancia ETI e IRAG,
el tablero nacional, y el acceso a EPIVIGILA. Suma las alertas sanitarias del ISP
—retiros de mercado, falsificaciones, farmacovigilancia y dispositivos médicos—,
que la clínica no recibía por ningún otro medio.

Solo lee y enlaza información pública: no copia ni rehospeda documentos del Estado,
no guarda datos en base de datos y no contiene información de pacientes.
    ]]></description>
    <version>0.5.0</version>
    <licence>agpl</licence>
    <author mail="d.espinoza.charrier@gmail.com">Daniel Espinoza</author>
    <namespace>Epidemiologia</namespace>
    <category>monitoring</category>
    <dependencies>
        <!-- Nextcloud only *recommends* intl, but MinsalRepository::fold() needs
             Normalizer, and fold() runs on every unified search by every user.
             Declared so a host without intl refuses to enable the app, instead of
             taking down global search with a fatal. -->
        <lib>intl</lib>
        <php min-version="8.2" max-version="8.5"/>
        <nextcloud min-version="34" max-version="34"/>
    </dependencies>
    <background-jobs>
        <job>OCA\Epidemiologia\BackgroundJob\ProbeJob</job>
    </background-jobs>
    <navigations>
        <navigation>
            <name>Epidemiología</name>
            <route>epidemiologia.page.index</route>
            <!-- Without <icon> the menu falls back to places/default-app-icon.svg,
                 the generic placeholder. img/app-dark.svg exists separately and is
                 used only by the notification: the navigation never asks for the
                 dark variant. -->
            <icon>epidemiologia.svg</icon>
            <!-- Deliberate: ahead of the apps with no <order>, which land at 100.
                 Alertas vigentes is consulted daily in the CESFAM. -->
            <order>5</order>
        </navigation>
    </navigations>
</info>
