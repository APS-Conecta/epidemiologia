# Sólo js/, css/ e img/ tienen que ser alcanzables por HTTP. El resto de este
# directorio es fuente y herramientas de desarrollo: node_modules pesa ~300 MB de
# JavaScript de terceros, y el .htaccess que trae Nextcloud pone `js` y `mjs` en
# su lista blanca de extensiones estáticas, así que sin esto node_modules queda
# servido entero a cualquier usuario autenticado.
#
# Es defensa en profundidad, no la solución: depende de Apache y de AllowOverride.
# Un despliegue que no compile aquí no debería tener node_modules en el webroot.
<IfModule mod_authz_core.c>
	<FilesMatch "^(package(-lock)?\.json|vite\.config\.js|openapi\.json|phpunit\.xml)$">
		Require all denied
	</FilesMatch>
</IfModule>

RedirectMatch 404 /custom_apps/epidemiologia/(node_modules|tools|tests|scripts|src|\.git)/
