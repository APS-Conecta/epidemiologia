# PHPUnit y el generador de OpenAPI se descargan a tools/, no se vendorizan.
/tools/
/.phpunit.cache/

# Build output — js/ and css/ are built, not committed: the release workflow builds
# them before packing the tarball (pack-app refuses a committed bundle), and a clone
# needs `npm ci && npm run build` before the app works. The .license notices vite emits
# beside the bundle land in js/ — ignored here, regenerated by every build — and they
# carry the third-party licence notices that travel inside the distribution.
/js/
/css/
/node_modules/

# Los sourcemaps no. Pesan 4,2 MB, cambian en cada build, y se regeneran con
# `npm run build` desde este mismo repositorio: quien pueda leerlos ya tiene el
# código. Versionarlos sería 4 MB de ruido por cada cambio de una línea.
*.map
*.map.license
