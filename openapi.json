{
    "openapi": "3.0.3",
    "info": {
        "title": "epidemiologia",
        "version": "0.10.0",
        "description": "Alertas del MINSAL, informe semanal de virus respiratorios del ISP y tablero nacional",
        "license": {
            "name": "AGPL-3.0-or-later"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/epidemiologia/api/v1/sources": {
            "get": {
                "operationId": "api-sources",
                "summary": "Everything this app publishes, keyed by source — or one source, whole",
                "description": "`total` counts what the answer carries and `has_more` says whether anything was left out: every answer here is whole, so the count is the fuente's own and `has_more` is false.",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "source",
                        "in": "query",
                        "description": "One of Sources::ALL. Omit for every source, as before.",
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Retired with SANITARY_ALERTS (ADR-0016): no fuente can be narrowed, so any value is a 400",
                        "schema": {
                            "type": "string",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "olderThan",
                        "in": "query",
                        "description": "Retired with the narrowing: any value is a 400",
                        "schema": {
                            "type": "integer",
                            "format": "int64",
                            "nullable": true,
                            "default": null
                        }
                    },
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Each source asked for, with its items, its freshness and its own degraded flag — item keys are the per-source union (reports carries `se`; the ISP alert feeds and OPS/OMS carry `date`, the publisher's day, and OPS/OMS `tipo` — alerta, actualizacion or otro; the MINSAL pages carry neither), per SourcesTest's name-every-key doctrine",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "object",
                                                        "required": [
                                                            "fetched_at",
                                                            "degraded",
                                                            "items"
                                                        ],
                                                        "properties": {
                                                            "fetched_at": {
                                                                "type": "integer",
                                                                "format": "int64",
                                                                "nullable": true
                                                            },
                                                            "degraded": {
                                                                "type": "boolean"
                                                            },
                                                            "items": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "title",
                                                                        "url",
                                                                        "year",
                                                                        "month"
                                                                    ],
                                                                    "properties": {
                                                                        "title": {
                                                                            "type": "string"
                                                                        },
                                                                        "url": {
                                                                            "type": "string"
                                                                        },
                                                                        "year": {
                                                                            "type": "string"
                                                                        },
                                                                        "month": {
                                                                            "type": "string"
                                                                        },
                                                                        "se": {
                                                                            "type": "string"
                                                                        },
                                                                        "date": {
                                                                            "type": "string"
                                                                        },
                                                                        "tipo": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                }
                                                            },
                                                            "total": {
                                                                "type": "integer",
                                                                "format": "int64"
                                                            },
                                                            "has_more": {
                                                                "type": "boolean"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Array-shaped garbage in a query parameter (`?source[]=x`), or a narrowing parameter (retired with SANITARY_ALERTS — refusing it loudly is how a still-paging consumer learns that)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "object",
                                                        "required": [
                                                            "fetched_at",
                                                            "degraded",
                                                            "items"
                                                        ],
                                                        "properties": {
                                                            "fetched_at": {
                                                                "type": "integer",
                                                                "format": "int64",
                                                                "nullable": true
                                                            },
                                                            "degraded": {
                                                                "type": "boolean"
                                                            },
                                                            "items": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "title",
                                                                        "url",
                                                                        "year",
                                                                        "month"
                                                                    ],
                                                                    "properties": {
                                                                        "title": {
                                                                            "type": "string"
                                                                        },
                                                                        "url": {
                                                                            "type": "string"
                                                                        },
                                                                        "year": {
                                                                            "type": "string"
                                                                        },
                                                                        "month": {
                                                                            "type": "string"
                                                                        },
                                                                        "se": {
                                                                            "type": "string"
                                                                        },
                                                                        "date": {
                                                                            "type": "string"
                                                                        },
                                                                        "tipo": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                }
                                                            },
                                                            "total": {
                                                                "type": "integer",
                                                                "format": "int64"
                                                            },
                                                            "has_more": {
                                                                "type": "boolean"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such source",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "additionalProperties": {
                                                        "type": "object",
                                                        "required": [
                                                            "fetched_at",
                                                            "degraded",
                                                            "items"
                                                        ],
                                                        "properties": {
                                                            "fetched_at": {
                                                                "type": "integer",
                                                                "format": "int64",
                                                                "nullable": true
                                                            },
                                                            "degraded": {
                                                                "type": "boolean"
                                                            },
                                                            "items": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "title",
                                                                        "url",
                                                                        "year",
                                                                        "month"
                                                                    ],
                                                                    "properties": {
                                                                        "title": {
                                                                            "type": "string"
                                                                        },
                                                                        "url": {
                                                                            "type": "string"
                                                                        },
                                                                        "year": {
                                                                            "type": "string"
                                                                        },
                                                                        "month": {
                                                                            "type": "string"
                                                                        },
                                                                        "se": {
                                                                            "type": "string"
                                                                        },
                                                                        "date": {
                                                                            "type": "string"
                                                                        },
                                                                        "tipo": {
                                                                            "type": "string"
                                                                        }
                                                                    }
                                                                }
                                                            },
                                                            "total": {
                                                                "type": "integer",
                                                                "format": "int64"
                                                            },
                                                            "has_more": {
                                                                "type": "boolean"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": []
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "api",
            "description": "The contract other apps read — and, once it has a home, the front webpage. OCSController rather than a plain Controller because the manual calls it the state-of-the-art surface and, more concretely, because a browser on another origin cannot be served any other way: enabling CORS on a plain Controller is \"generally and highly discouraged\", since the CSRF check then fails unless security is disabled. The planned dashboard is exactly that case. Consumers send `OCS-APIRequest: true` and get the OCS envelope back: GET /ocs/v2.php/apps/epidemiologia/api/v1/sources { \"ocs\": { \"meta\": {…}, \"data\": { \"alerts\": { \"fetched_at\": …, \"degraded\": false, \"items\": [ … ] }, \"reports\": { … } } } } ONE route keyed by source, not a route per source — see ADR-0006. Nextcloud serves the one kind of consumer this contract exists for exactly this way: `dashboard.rst` returns `ocs.data` keyed by widget id, and `cloud/capabilities` keyed by app. Resource-per-endpoint, as groupfolders does it, is for mutable things with ids and a CRUD surface, which this app has none of. No #[CORS] yet: it needs a concrete origin and the dashboard does not have one. Adding it blind would widen the surface for nobody."
        }
    ]
}
